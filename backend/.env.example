# Backend environment
DB_HOST=localhost
DB_PORT=3306
DB_NAME=minhaj_library
DB_USER=your_db_user
DB_PASS=your_db_password

# Token expiry in seconds (default: 7 days)
TOKEN_EXPIRY=604800

# Upload settings
UPLOAD_MAX_SIZE=3145728
UPLOAD_DIR=uploads/covers

# App environment
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/MinhajLiberary/backend/public
